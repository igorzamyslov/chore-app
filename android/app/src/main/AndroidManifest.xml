<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="Famdo"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Supabase magic-link auth callback (spec
                 docs/specs/sync-backend.md §5): a custom scheme needs no
                 autoVerify; supabase_flutter completes the sign-in itself
                 once the deep link reaches the app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="famdo" android:host="auth-callback"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- flutter_local_notifications (spec docs/specs/notifications.md):
             lets the plugin actually show a notification scheduled via
             zonedSchedule, and re-arm it after the device reboots. No
             SCHEDULE_EXACT_ALARM/USE_EXACT_ALARM receiver or permission is
             registered here — the digest deliberately uses
             AndroidScheduleMode.inexactAllowWhileIdle, which needs neither. -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
    </application>

    <!-- flutter_local_notifications (spec docs/specs/notifications.md):
         POST_NOTIFICATIONS is requested at runtime (Android 13+) on first
         digest enable, not at launch; RECEIVE_BOOT_COMPLETED lets the
         scheduled-notification boot receiver above re-arm the digest after
         a reboot. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Optional sync (spec docs/specs/sync-backend.md): Supabase auth +
         REST + realtime need INTERNET. MUST be declared HERE, in the main
         manifest — Flutter's template only declares it in the debug and
         profile manifests (android/app/src/{debug,profile}/), for hot
         reload. This app was local-first and needed no network at all
         until v0.2.0, so the gap only surfaced in the first RELEASE build
         that used sync: every Supabase call failed silently and sign-in
         reported the generic "Couldn't send the sign-in link" (v0.2.0,
         root-caused 2026-08-01 via `aapt2 dump permissions` on the
         shipped APK). Debug builds could never reproduce it. The release
         workflow now asserts this permission is present in the built APK
         before publishing — see .github/workflows/release.yml. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
