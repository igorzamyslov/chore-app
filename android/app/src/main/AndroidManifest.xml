<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Auto-backup posture (decision D-B1, docs/backlog.md; implementation
         plan docs/plans/2026-08-08-android-backup.md): this app's answer to
         "don't lose my data" is sync plus the JSON export (Settings ->
         Export data), not the OS. Left unconfigured, Auto Backup defaults
         to ON with no rules — Android would copy the live SQLite file
         (chore_app.sqlite) plus its -wal/-shm sidecars uncoordinated (a
         restore can land a torn database) and restore the Supabase
         refresh token, the sync pull cursor (settings.syncLastPulledAt)
         and the device-scoped settings.actingMemberId onto a second
         device — under this app's last-push-wins conflict rule that
         clobbers data rather than merely confusing.
         allowBackup="false" disables BOTH classic cloud Auto Backup and
         Android 12+'s device-to-device transfer for every API level this
         app supports (minSdk 24). android:fullBackupContent and
         android:dataExtractionRules are backup-content FILTERS the
         platform only consults when allowBackup is true, so they are
         deliberately not declared — there would be nothing for them to
         filter. Asserted on the built release APK in
         .github/workflows/release.yml so this can never silently
         regress, same pattern as the INTERNET permission check below.
         iOS is a separate, tracked gap (docs/backlog.md A-3b) — iCloud
         backs up Documents/, where this database also lives, by
         default. -->
    <application
        android:label="Famdo"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Supabase magic-link auth callback (spec
                 docs/specs/sync-backend.md §5): a custom scheme needs no
                 autoVerify; supabase_flutter completes the sign-in itself
                 once the deep link reaches the app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="famdo" android:host="auth-callback"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- flutter_local_notifications (spec docs/specs/notifications.md):
             lets the plugin actually show a notification scheduled via
             zonedSchedule, and re-arm it after the device reboots. No
             SCHEDULE_EXACT_ALARM/USE_EXACT_ALARM receiver or permission is
             registered here — the digest deliberately uses
             AndroidScheduleMode.inexactAllowWhileIdle, which needs neither.
             The third receiver below is what makes the digest's notification
             ACTION work; it is likewise a component declaration, not a
             permission, so none of the three adds a <uses-permission>. -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <!-- Required for notification ACTION buttons — the digest's "Done"
             action (spec docs/specs/notifications.md N2, backlog F-1) — to
             reach anything at all.
             WHY IT MUST BE DECLARED HERE: the plugin's own AndroidManifest.xml
             declares no receivers whatsoever (verified in the installed 22.1.0
             package — it contains two <uses-permission> lines and nothing
             else), so every receiver is the app's job. And an action built with
             showsUserInterface: false is dispatched through
             PendingIntent.getBroadcast targeting exactly this class; if Android
             cannot resolve the component, the tap does nothing and reports
             nothing, anywhere.
             That failure mode is indistinguishable from a working app right up
             until a user taps the button, so it warrants an assertion on the
             built RELEASE artifact (docs/handover-2026-08-14-planning.md §6),
             the same way INTERNET and allowBackup already are.
             That assertion now EXISTS: .github/workflows/release.yml's
             "Verify release APK can dispatch notification actions" step greps
             the compiled manifest for this exact class name and fails the
             release if it is gone. Deleting the line below therefore fails
             the next tag build rather than shipping a dead button. The two
             sibling receivers are not asserted — see that step's comment for
             why. -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver" />
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
    </application>

    <!-- flutter_local_notifications (spec docs/specs/notifications.md):
         POST_NOTIFICATIONS is requested at runtime (Android 13+) on first
         digest enable, not at launch; RECEIVE_BOOT_COMPLETED lets the
         scheduled-notification boot receiver above re-arm the digest after
         a reboot. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Optional sync (spec docs/specs/sync-backend.md): Supabase auth +
         REST + realtime need INTERNET. MUST be declared HERE, in the main
         manifest — Flutter's template only declares it in the debug and
         profile manifests (android/app/src/{debug,profile}/), for hot
         reload. This app was local-first and needed no network at all
         until v0.2.0, so the gap only surfaced in the first RELEASE build
         that used sync: every Supabase call failed silently and sign-in
         reported the generic "Couldn't send the sign-in link" (v0.2.0,
         root-caused 2026-08-01 via `aapt2 dump permissions` on the
         shipped APK). Debug builds could never reproduce it. The release
         workflow now asserts this permission is present in the built APK
         before publishing — see .github/workflows/release.yml. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
